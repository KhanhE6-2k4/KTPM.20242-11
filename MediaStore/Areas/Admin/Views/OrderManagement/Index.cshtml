@model IEnumerable<MediaStore.Data.OrderInfo>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    // Layout = "_AdminLayout"; // Hoặc layout Admin của bạn
}

<h1>Quản lý Đơn hàng</h1>
<hr />

<form asp-action="Index" method="get" class="row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label for="customerName" class="form-label">Tên khách hàng</label>
        <input type="text" name="customerName" id="customerName" value="@ViewBag.CustomerNameFilter" class="form-control form-control-sm" />
    </div>
    <div class="col-md-3">
        <label for="orderStatus" class="form-label">Trạng thái</label>
        <select name="orderStatus" id="orderStatus" class="form-select form-select-sm" asp-items="@(new SelectList(ViewBag.PossibleStatuses, ViewBag.OrderStatusFilter))">
            @* <option value="">-- Tất cả --</option> *@ @* Có thể thêm nếu không muốn "All" là mặc định *@
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary btn-sm w-100">Lọc</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary btn-sm w-100">Xóa lọc</a>
    </div>
</form>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped table-hover table-sm">
    <thead class="table-dark">
        <tr>
            <th>ID Đơn hàng</th>
            <th>Tên Khách hàng</th>
            <th>Địa chỉ</th>
            <th>Tổng tiền (ước tính)</th>
            <th>Trạng thái</th>
            <th>Ngày đặt (Nếu có)</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@(order.Delivery?.Name ?? "N/A")</td>
                <td>@(order.Delivery?.Address), @(order.Delivery?.Province)</td>
                <td>@((order.Subtotal + order.ShippingFees).ToString("N0")) đ</td>
                <td>
                    <span class="badge 
                        @if(order.Status == "Completed") {<text>bg-success</text>}
                        else if(order.Status == "Cancelled" || order.Status == "Rejected") {<text>bg-danger</text>}
                        else if(order.Status == "Processing" || order.Status == "Shipped") {<text>bg-info</text>}
                        else {<text>bg-warning text-dark</text>}">
                        @order.Status
                    </span>
                </td>
                <td>@* Bạn cần một trường Ngày đặt hàng trong OrderInfo Entity nếu muốn hiển thị *@</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-info">Xem Chi tiết</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="7" class="text-center">Không có đơn hàng nào phù hợp.</td></tr>
    }
    </tbody>
</table>

@if (ViewBag.TotalOrders > 0)
{
    <p>Hiển thị @Model.Count() trên tổng số @ViewBag.TotalOrders đơn hàng.</p>
}

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @if (ViewBag.TotalPages > 1)
        {
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, customerName = ViewBag.CustomerNameFilter, orderStatus = ViewBag.OrderStatusFilter })">Trước</a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, customerName = ViewBag.CustomerNameFilter, orderStatus = ViewBag.OrderStatusFilter })">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, customerName = ViewBag.CustomerNameFilter, orderStatus = ViewBag.OrderStatusFilter })">Sau</a>
            </li>
        }
    </ul>
</nav>

<a asp-area="Admin" asp-controller="OrderManagement" asp-action="Index" class="list-group-item list-group-item-action">
    Quản lý Đơn hàng
    <small class="d-block text-muted">Xem và cập nhật trạng thái các đơn hàng.</small>
</a>