@model MediaStore.ViewModels.AdminCreateProductViewModel 
@{ 
    ViewData["Title"] = "Chi tiết Sản phẩm";
    // Layout = "_AdminLayout"; 
}

<h1>Chi tiết Sản phẩm</h1>
<hr />
@if (Model != null)
{
    <div>
        <h4>@Model.Title</h4>
        <dl class="row">
            <dt class="col-sm-3">ID Sản phẩm:</dt>
            <dd class="col-sm-9">@ViewBag.ProductId</dd> @* Controller Details cần gán ViewBag.ProductId = id; *@

            <dt class="col-sm-3">Loại Media:</dt>
            <dd class="col-sm-9">@Model.MediaType</dd>

            <dt class="col-sm-3">Giá:</dt>
            <dd class="col-sm-9">@Model.Price.ToString("N0") đ</dd>

            <dt class="col-sm-3">Số lượng tồn:</dt>
            <dd class="col-sm-9">@Model.TotalQuantity</dd>

            <dt class="col-sm-3">Cân nặng:</dt>
            <dd class="col-sm-9">@Model.Weight kg</dd>

            <dt class="col-sm-3">Hỗ trợ giao hỏa tốc:</dt>
            <dd class="col-sm-9">@(Model.RushOrderSupported ? "Có" : "Không")</dd>

            @if(!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <dt class="col-sm-3">Hình ảnh:</dt>
                <dd class="col-sm-9"><img src="@Model.ImageUrl" alt="@Model.Title" style="max-width:200px;" class="img-thumbnail"/></dd>
            }

            <dt class="col-sm-3">Barcode:</dt>
            <dd class="col-sm-9">@Model.Barcode</dd>

            <dt class="col-sm-3">Mô tả:</dt>
            <dd class="col-sm-9">@Html.Raw(Model.Description?.Replace("\n", "<br />"))</dd>

            @if(!string.IsNullOrEmpty(Model.ProductDimension))
            {
                <dt class="col-sm-3">Kích thước:</dt>
                <dd class="col-sm-9">@Model.ProductDimension</dd>
            }
            @if(Model.ImportDate.HasValue)
            {
                <dt class="col-sm-3">Ngày nhập:</dt>
                <dd class="col-sm-9">@Model.ImportDate.Value.ToString("dd/MM/yyyy")</dd>
            }

            @* Hiển thị thông tin chi tiết dựa trên MediaType *@
            @if (Model.MediaType == "Book")
            {
                <dt class="col-sm-3">Tác giả:</dt><dd class="col-sm-9">@Model.Authors</dd>
                <dt class="col-sm-3">Loại bìa:</dt><dd class="col-sm-9">@Model.CoverType</dd>
                <dt class="col-sm-3">Nhà XB:</dt><dd class="col-sm-9">@Model.Publisher</dd>
                @if(Model.PublicationDate.HasValue){ <dt class="col-sm-3">Ngày XB:</dt><dd class="col-sm-9">@Model.PublicationDate.Value.ToString("dd/MM/yyyy")</dd> }
                @if(Model.Pages.HasValue){ <dt class="col-sm-3">Số trang:</dt><dd class="col-sm-9">@Model.Pages</dd> }
                @if(!string.IsNullOrEmpty(Model.BookLanguage)){ <dt class="col-sm-3">Ngôn ngữ (Sách):</dt><dd class="col-sm-9">@Model.BookLanguage</dd> }
                @if(!string.IsNullOrEmpty(Model.BookGenre)){ <dt class="col-sm-3">Thể loại (Sách):</dt><dd class="col-sm-9">@Model.BookGenre</dd> }
            }
            else if (Model.MediaType == "DVD")
            {
                <dt class="col-sm-3">Loại DVD:</dt><dd class="col-sm-9">@Model.DvdType</dd>
                <dt class="col-sm-3">Đạo diễn:</dt><dd class="col-sm-9">@Model.Director</dd>
                @if(Model.Runtime.HasValue){ <dt class="col-sm-3">Thời lượng:</dt><dd class="col-sm-9">@Model.Runtime phút</dd> }
                <dt class="col-sm-3">Hãng phim:</dt><dd class="col-sm-9">@Model.Studio</dd>
                <dt class="col-sm-3">Ngôn ngữ (DVD):</dt><dd class="col-sm-9">@Model.DvdLanguage</dd>
                <dt class="col-sm-3">Phụ đề:</dt><dd class="col-sm-9">@Model.Subtitles</dd>
                @if(Model.ReleasedDate.HasValue){ <dt class="col-sm-3">Ngày phát hành (DVD):</dt><dd class="col-sm-9">@Model.ReleasedDate.Value.ToString("dd/MM/yyyy")</dd> }
                @if(!string.IsNullOrEmpty(Model.DvdGenre)){ <dt class="col-sm-3">Thể loại (DVD):</dt><dd class="col-sm-9">@Model.DvdGenre</dd> }
            }
            else if (Model.MediaType == "CD" || Model.MediaType == "LP")
            {
                <dt class="col-sm-3">Nghệ sĩ:</dt><dd class="col-sm-9">@Model.Artists</dd>
                <dt class="col-sm-3">Hãng đĩa:</dt><dd class="col-sm-9">@Model.RecordLabel</dd>
                <dt class="col-sm-3">Danh sách bài hát:</dt><dd class="col-sm-9">@Html.Raw(Model.TrackList?.Replace("\n", "<br />"))</dd>
                <dt class="col-sm-3">Thể loại (CD/LP):</dt><dd class="col-sm-9">@Model.CdLpGenre</dd>
                @if(Model.CdLpReleaseDate.HasValue){ <dt class="col-sm-3">Ngày phát hành (CD/LP):</dt><dd class="col-sm-9">@Model.CdLpReleaseDate.Value.ToString("dd/MM/yyyy")</dd> }
            }
        </dl>
    </div>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@ViewBag.ProductId" class="btn btn-primary">Chỉnh sửa</a> |
        <a asp-action="Index" class="btn btn-secondary">Quay lại Danh sách</a>
    </div>
}
else
{
    <p>Không tìm thấy thông tin sản phẩm.</p>
    <a asp-action="Index" class="btn btn-secondary">Quay lại Danh sách</a>
}