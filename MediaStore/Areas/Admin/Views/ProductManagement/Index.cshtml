@model IEnumerable<MediaStore.ViewModels.ProductViewModel> 
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    // Layout = "_Layout"; // Hoặc layout Admin nếu có
}

<div class="container mt-4">
    <h1>Quản lý Sản phẩm</h1>
    <hr/>

    <p>
        <a asp-action="Create" class="btn btn-primary">Tạo Sản phẩm Mới</a>
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm kiếm theo tên sản phẩm..." />
            <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng tồn</th>
                <th>Loại</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MediaId</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" style="max-width: 80px; max-height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <img src="~/images/placeholder.png" alt="No image" style="max-width: 80px; max-height: 80px; object-fit: cover;" /> //  Đường dẫn đến ảnh placeholder của bạn
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>@item.Price.ToString("N0") đ</td>
                        <td>@Html.DisplayFor(modelItem => item.TotalQuantity)</td>
                        <td>@Html.DisplayFor(modelItem => item.Type)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.MediaId" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.MediaId" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-action="Delete" asp-route-id="@item.MediaId" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">Không có sản phẩm nào được tìm thấy hoặc chưa có sản phẩm nào.</td>
                </tr>
            }
        </tbody>
    </table>

    @if (ViewBag.TotalProduct > 0)
    {
        <p>Hiển thị @Model.Count() trên tổng số @ViewBag.TotalProduct sản phẩm.</p>
    }

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @if (ViewBag.TotalPages > 1)
            {
                // Nút Previous
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, searchString = ViewBag.SearchString, TypeName = ViewBag.TypeName })">Trước</a>
                </li>

                // Các nút trang
                for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString, TypeName = ViewBag.TypeName })">@i</a>
                    </li>
                }

                // Nút Next
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, searchString = ViewBag.SearchString, TypeName = ViewBag.TypeName })">Sau</a>
                </li>
            }
        </ul>
    </nav>
</div>