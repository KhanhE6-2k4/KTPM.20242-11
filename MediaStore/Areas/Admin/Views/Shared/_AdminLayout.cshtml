<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" /> @* Đảm bảo tệp admin.css này tồn tại trong wwwroot/css/ *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse"> @* Thêm id và class collapse cho responsive *@
                <div class="position-sticky pt-3">  @* Thêm pt-3 cho padding top *@
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["area"]?.ToString() == "Admin" ? "active" : "")" 
                               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <span data-feather="home"></span> @* Ví dụ thêm icon *@
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProductManagement" && ViewContext.RouteData.Values["area"]?.ToString() == "Admin" ? "active" : "")" 
                               asp-area="Admin" asp-controller="ProductManagement" asp-action="Index">
                                <span data-feather="shopping-cart"></span> @* Ví dụ thêm icon *@
                                Manage Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "OrderManagement" && ViewContext.RouteData.Values["area"]?.ToString() == "Admin" ? "active" : "")" 
                               asp-area="Admin" asp-controller="OrderManagement" asp-action="Index">
                                <span data-feather="file-text"></span> @* Ví dụ thêm icon *@
                                Orders
                            </a>
                        </li>
                        @* Thêm mục Logout nếu cần *@
                        <li class="nav-item mt-auto mb-2"> @* Đẩy Logout xuống dưới nếu là menu chính *@
                             <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Logout">
                                <span data-feather="log-out"></span>
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4"> @* Thêm px-md-4 cho padding ngang *@
                @* Nút bật/tắt sidebar cho màn hình nhỏ (nếu dùng class collapse ở trên) *@
                <button class="navbar-toggler d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">@ViewData["Title"]</h1>
                </div>
                @RenderBody()
            </main>
        </div>
    </div>

    @* =============================================================== *@
    @* == ĐẢM BẢO JQUERY ĐƯỢC TẢI TRƯỚC KHI RENDER SECTION SCRIPTS == *@
    @* =============================================================== *@
    <script src="~/lib/jquery/jquery.min.js"></script> @* Đường dẫn này là mặc định của project ASP.NET Core, kiểm tra xem có đúng không *@
                                                      @* Hoặc nếu bạn dùng CDN: <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    @* Các script chung khác của bạn có thể đặt ở đây *@
    @* Ví dụ, nếu bạn dùng thư viện icon Feather: 
       <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
       <script>feather.replace()</script> 
    *@
    
    @await RenderSectionAsync("Scripts", required: false) @* Dòng này đã có và đúng vị trí *@
</body>
</html>