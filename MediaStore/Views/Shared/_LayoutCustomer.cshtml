        document.addEventListener('DOMContentLoaded', function() {
            document.addEventListener('click', function(event) {
            // Tìm phần tử .modal-opener (nếu click ở trong nó hoặc chính nó)
            var opener = event.target.closest('.modal-opener');
             if (!opener) return; // nếu không phải click vào .modal-opener thì bỏ qua

            // Lấy giá trị id từ thuộc tính data-id
            var id = opener.getAttribute('data-id');
            if (!id) return;

            // Tìm modal tương ứng với id đó
            var modalEl = document.getElementById('dialog-modal-' + id);
            if (!modalEl) return;

            // Khởi tạo và mở modal Bootstrap 5
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
            });
        });

        @* $(document).ready(function () {
