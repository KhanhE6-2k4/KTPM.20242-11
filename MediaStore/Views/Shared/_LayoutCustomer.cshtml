    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/js/main.js"></script>
    <script src="~/js/cart.js"></script>
    <script src="~/js/popup.js"></script>
    @RenderSection("Scripts", required: false)
